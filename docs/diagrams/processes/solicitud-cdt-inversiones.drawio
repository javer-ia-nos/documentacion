        <mxCell id="phase2-label" value="Fase 2 — Consulta de rendimientos" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="1100" width="700" height="24" as="geometry" />
