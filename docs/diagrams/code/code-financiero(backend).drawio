<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="77VYCzvV8YWxhxsZ32P3">
    <mxGraphModel dx="861" dy="783" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; --- DTOs (Data Transfer Objects) ---\nclass LoanRequestDTO {\n    +userId: UUID\n    +requestedAmount: DECIMAL\n    +termMonths: INTEGER\n}\n\nclass LoanResponseDTO {\n    +loanId: UUID\n    +status: VARCHAR\n    +estimatedMonthlyInstallment: DECIMAL\n}\n\nclass CDTRequestDTO {\n    +userId: UUID\n    +amount: DECIMAL\n    +termDays: INTEGER\n}\n\nclass InvestmentRequestDTO {\n    +userId: UUID\n    +amount: DECIMAL\n    +productCode: VARCHAR\n}\n\n&#39; --- Domain Entities (Matches E/R Diagram) ---\nclass Loan {\n    +id: UUID\n    +userId: UUID\n    +principal: DECIMAL\n    +interestRate: DECIMAL\n    +termMonths: INTEGER\n    +startDate: TIMESTAMP\n    +endDate: TIMESTAMP\n    +status: VARCHAR\n    +isDeleted: BOOLEAN\n}\n\nclass LoanInstallment {\n    +id: UUID\n    +loanId: UUID\n    +installmentNumber: INTEGER\n    +amount: DECIMAL\n    +principalPart: DECIMAL\n    +interestPart: DECIMAL\n    +dueDate: TIMESTAMP\n    +paidDate: TIMESTAMP\n    +status: VARCHAR\n}\n\nclass CDT {\n    +id: UUID\n    +userId: UUID\n    +accountId: UUID\n    +principal: DECIMAL\n    +interestRate: DECIMAL\n    +termDays: INTEGER\n    +startDate: TIMESTAMP\n    +maturityDate: TIMESTAMP\n    +status: VARCHAR\n}\n\nclass Investment {\n    +id: UUID\n    +userId: UUID\n    +productCode: VARCHAR\n    +productName: VARCHAR\n    +amount: DECIMAL\n    +investedAt: TIMESTAMP\n    +expectedYield: DECIMAL\n    +status: VARCHAR\n    +isDeleted: BOOLEAN\n}\n\nclass InterestRate {\n    +id: UUID\n    +productType: VARCHAR\n    +rate: DECIMAL\n    +validFrom: TIMESTAMP\n    +validTo: TIMESTAMP\n    +isDeleted: BOOLEAN\n}\n\nclass ExternalFinancialRegulator {\n    +id: UUID\n    +name: VARCHAR\n    +country: VARCHAR\n    +endpoint: VARCHAR\n}\n\n&#39; --- Repositories (Data Access) ---\ninterface ILoanRepository {\n    +findById(id: UUID): Loan\n    +save(loan: Loan): Loan\n}\n\ninterface ICDTRepository {\n    +findByUserId(userId: UUID): List&lt;CDT&gt;\n    +save(cdt: CDT): CDT\n}\n\ninterface IInvestmentRepository {\n    +findByUserId(userId: UUID): List&lt;Investment&gt;\n    +save(investment: Investment): Investment\n}\n\n&#39; --- Cross-Cutting &amp; External Dependencies (New) ---\ninterface ICreditBureauService {\n    +checkCreditHistory(userId: UUID): Boolean\n}\n\ninterface IAuditService {\n    +logTransaction(action: VARCHAR, details: VARCHAR): void\n}\n\ninterface IAccountService {\n    +debitAccount(accountId: UUID, amount: DECIMAL): void\n    +creditAccount(accountId: UUID, amount: DECIMAL): void\n}\n\n&#39; --- Service Interfaces (Dependency Inversion) ---\ninterface ILoanService {\n    +requestLoan(request: LoanRequestDTO): LoanResponseDTO\n    +calculateAmortization(loanId: UUID): List&lt;LoanInstallment&gt;\n    +payInstallment(installmentId: UUID): void\n}\n\ninterface ICDTService {\n    +createCDT(request: CDTRequestDTO): CDT\n    +calculateYield(amount: DECIMAL, rate: DECIMAL): DECIMAL\n}\n\ninterface IInvestmentService {\n    +createInvestment(request: InvestmentRequestDTO): Investment\n    +reportToRegulator(investmentId: UUID): void\n}\n\n&#39; --- Concrete Services ---\nclass LoanService {\n    -loanRepo: ILoanRepository\n    -creditBureau: ICreditBureauService\n    -accountService: IAccountService\n    -auditService: IAuditService\n}\n\nclass CDTService {\n    -cdtRepo: ICDTRepository\n    -accountService: IAccountService\n    -auditService: IAuditService\n}\n\nclass InvestmentService {\n    -investmentRepo: IInvestmentRepository\n    -accountService: IAccountService\n    -auditService: IAuditService\n}\n\n&#39; --- Controllers (REST API) ---\nclass FinancialController {\n    -loanService: ILoanService\n    -cdtService: ICDTService\n    -investmentService: IInvestmentService\n    +postLoanRequest(req: Request): Response\n    +postCDT(req: Request): Response\n    +postInvestment(req: Request): Response\n}\n\n&#39; --- Relationships &amp; Dependencies ---\nLoan \&quot;1\&quot; *-- \&quot;*\&quot; LoanInstallment : contains\n\n&#39; Implementations\nLoanService ..|&gt; ILoanService\nCDTService ..|&gt; ICDTService\nInvestmentService ..|&gt; IInvestmentService\n\n&#39; Controller Injections\nFinancialController --&gt; ILoanService : injects\nFinancialController --&gt; ICDTService : injects\nFinancialController --&gt; IInvestmentService : injects\n\n&#39; Repositories Usage\nLoanService --&gt; ILoanRepository : uses\nCDTService --&gt; ICDTRepository : uses\nInvestmentService --&gt; IInvestmentRepository : uses\n\n&#39; External &amp; Cross-Cutting Integrations\nLoanService --&gt; ICreditBureauService : validates via\nLoanService --&gt; IAccountService : updates balance\nCDTService --&gt; IAccountService : updates balance\nInvestmentService --&gt; IAccountService : updates balance\n\nLoanService --&gt; IAuditService : logs to\nCDTService --&gt; IAuditService : logs to\nInvestmentService --&gt; IAuditService : logs to\n\n&#39; DTOs Usage\nFinancialController ..&gt; LoanRequestDTO : receives\nFinancialController ..&gt; LoanResponseDTO : returns\nFinancialController ..&gt; CDTRequestDTO : receives\nFinancialController ..&gt; InvestmentRequestDTO : receives\n\n&#39; Entity Management\nLoanService ..&gt; Loan : manages\nCDTService ..&gt; CDT : manages\nInvestmentService ..&gt; Investment : manages\n\n&#39; Lookups &amp; Regulatory\nLoanService ..&gt; InterestRate : looks up\nCDTService ..&gt; InterestRate : looks up\nInvestmentService ..&gt; ExternalFinancialRegulator : reports to\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ycKcHxSd2ZkrdpwPe-lP-558">
