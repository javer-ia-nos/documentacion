<mxfile host="app.diagrams.net">
  <diagram name="Deployment - Desarrollo" id="deployment-dev">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="Deployment View: Banca Digital — Ambiente de Desarrollo" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="maquina" value="Máquina del desarrollador [Deployment Node: Linux o macOS · Docker · Bun 1.3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=26;spacingTop=6;fontStyle=1;fontColor=#444444;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="60" width="1580" height="880" as="geometry" /></mxCell>
        <mxCell id="navegador" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;o Bun.WebView en las pruebas E2E" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="host" value="Procesos en el host — solo el servicio que se está modificando" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#444444;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="470" height="190" as="geometry" /></mxCell>
        <mxCell id="host-ms" value="&lt;b&gt;Microservicio en desarrollo&lt;/b&gt;&lt;br&gt;[bun --watch src/index.ts]&lt;br&gt;usa las bases, Kafka y los demás servicios del Compose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#1a1a1a;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="430" height="60" as="geometry" /></mxCell>
        <mxCell id="host-web" value="&lt;b&gt;web en desarrollo&lt;/b&gt;&lt;br&gt;[astro dev --port 3000]&lt;br&gt;en lugar del contenedor web" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#1a1a1a;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="430" height="55" as="geometry" /></mxCell>
        <mxCell id="ci" value="GitHub Actions [CI de cada repositorio]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#444444;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="560" height="190" as="geometry" /></mxCell>
        <mxCell id="ci-test" value="&lt;b&gt;Run Tests&lt;/b&gt;&lt;br&gt;bun check · bun fmt --check · bun test&lt;br&gt;(con su propio PostgreSQL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#1a1a1a;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="140" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="ci-img" value="&lt;b&gt;Publicar imagen&lt;/b&gt;&lt;br&gt;ghcr.io/javer-ia-nos/&amp;lt;repo&amp;gt;:latest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E6295;strokeColor=#1a3f5c;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="140" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="ci-nota" value="El Compose descarga las imágenes :latest de GHCR o, si no hay acceso, las construye desde los repositorios vecinos (../ms-*)." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1020" y="220" width="520" height="50" as="geometry" /></mxCell>
        <mxCell id="compose" value="Docker Compose del repositorio integracion [docker-compose.yml] — el mismo entorno que usan las pruebas E2E" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#444444;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1520" height="610" as="geometry" /></mxCell>
        <mxCell id="web" value="&lt;b&gt;web&lt;/b&gt;&lt;br&gt;[Astro SSR · Node]&lt;br&gt;:3000 → proxy /api" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="370" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;api-gateway&lt;/b&gt;&lt;br&gt;[Bun + Elysia :4860]&lt;br&gt;sesión, RBAC, CORS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E6295;strokeColor=#1a3f5c;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="370" width="220" height="70" as="geometry" /></mxCell>
