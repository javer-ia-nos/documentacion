        <!-- Steps 13-18 (consulta de rendimientos) -->
        <mxCell id="step13" value="13. Solicita consultar el rendimiento de sus CDT e inversiones" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="1150" as="sourcePoint" />
            <mxPoint x="450" y="1150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step14" value="14. Consulta rendimientos (API)" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="1220" as="sourcePoint" />
            <mxPoint x="750" y="1220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step15" value="15. Lee los CDT/Investment del cliente junto con la tasa vigente" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="1290" as="sourcePoint" />
            <mxPoint x="1350" y="1290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step16" value="16. Retorna los registros y el rendimiento calculado" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;dashed=1;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1350" y="1360" as="sourcePoint" />
            <mxPoint x="750" y="1360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step17" value="17. Responde con el detalle de rendimientos" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;dashed=1;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="1430" as="sourcePoint" />
            <mxPoint x="450" y="1430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step18" value="18. Muestra el rendimiento proyectado y actual" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;dashed=1;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="1490" as="sourcePoint" />
            <mxPoint x="150" y="1490" as="targetPoint" />
          </mxGeometry>
        </mxCell>

