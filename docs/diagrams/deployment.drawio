        <mxCell id="ms-notificaciones" value="&lt;b&gt;ms-notificaciones&lt;/b&gt;&lt;br&gt;:4868" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="704" y="535" width="190" height="60" as="geometry" /></mxCell>
