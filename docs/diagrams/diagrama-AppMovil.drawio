<mxfile host="app.diagrams.net">
  <diagram name="Vista-C4-Personalizada" id="c4-custom-view">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Grupo Principal / Contenedor de Sistema -->
        <mxCell id="group-banca" parent="1" style="swimlane;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;strokeColor=#666666;strokeWidth=2;fillColor=rgba(0, 0, 0, 0.02);fontColor=#666666;fontSize=18;startSize=30;align=left;spacingLeft=15;" value="&lt;b&gt;Sistema Bancario &amp; Servicios&lt;/b&gt;" vertex="1">
          <mxGeometry height="900" width="1600" x="400" y="300" as="geometry" />
        </mxCell>

        <!-- PERSONA / ACTOR -->
        <object placeholders="1" c4Name="Cliente Principal" c4Type="Persona" c4Description="Usuario que gestiona sus productos financieros desde la plataforma web y móvil." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="actor-cliente">
          <mxCell parent="1" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E8B00;fontColor=#2E8B00;shape=mxgraph.c4.person2;strokeWidth=2;align=center;verticalAlign=top;spacingTop=8;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1">
            <mxGeometry height="180" width="240" x="780" y="60" as="geometry" />
          </mxCell>
        </object>

        <!-- APLICACIONES / CLIENTES FRONTEND -->
        <object placeholders="1" c4Name="Aplicación Web (SPA)" c4Type="web: React / TypeScript" c4Description="Portal web para consulta de saldos y transferencias." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="app-web">
          <mxCell parent="group-banca" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#FFFFFF;fontColor=#438DD5;align=center;arcSize=6;strokeColor=#438DD5;strokeWidth=2;verticalAlign=top;spacingTop=6;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="160" width="240" x="100" y="80" as="geometry" />
          </mxCell>
        </object>

        <object placeholders="1" c4Name="Aplicación Móvil" c4Type="mobile: React Native" c4Description="Acceso a servicios bancarios desde teléfonos inteligentes." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="app-mobile">
          <mxCell parent="group-banca" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#FFFFFF;fontColor=#438DD5;align=center;arcSize=10;strokeColor=#438DD5;strokeWidth=2;verticalAlign=top;spacingTop=6;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="160" width="240" x="420" y="80" as="geometry" />
          </mxCell>
        </object>

        <!-- BACKEND / HEXÁGONO -->
        <object placeholders="1" c4Name="Servicio Backend Principal" c4Type="backend: API REST / Node.js" c4Description="Procesa la lógica transaccional, autenticación y orquestación de servicios." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="backend-api">
          <mxCell parent="group-banca" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#85BBF0;fontColor=#5B8EB8;align=center;strokeWidth=2;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="180" width="280" x="240" y="360" as="geometry" />
          </mxCell>
        </object>

        <!-- BASE DE DATOS / CILINDRO -->
        <object placeholders="1" c4Name="Base de Datos Transaccional" c4Type="database: PostgreSQL" c4Description="Almacena usuarios, transacciones y productos financieros." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="db-postgres">
          <mxCell parent="group-banca" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#85BBF0;fontColor=#5B8EB8;align=center;strokeWidth=2;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="180" width="260" x="250" y="650" as="geometry" />
          </mxCell>
        </object>

        <!-- SISTEMAS EXTERNOS -->
        <object placeholders="1" c4Name="Proveedor de Notificaciones" c4Type="Sistema Externo" c4Description="Envío de SMS, correos electrónicos y alertas Push." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ext-notificaciones">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#FFFFFF;fontColor=#B22222;strokeColor=#B22222;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;arcSize=8;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="140" width="240" x="100" y="1250" as="geometry" />
          </mxCell>
        </object>

        <object placeholders="1" c4Name="Pasarela de Pagos" c4Type="Sistema Externo" c4Description="Procesa transacciones y liquidaciones externas." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="ext-pagos">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#FFFFFF;fontColor=#D6690F;strokeColor=#D6690F;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;arcSize=8;metaEdit=1;resizable=0;" vertex="1">
            <mxGeometry height="140" width="240" x="420" y="1250" as="geometry" />
          </mxCell>
        </object>

        <!-- CONEXIONES Y RELACIONES -->
        <mxCell id="rel-1" edge="1" parent="1" source="actor-cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#707070;strokeWidth=1;" target="app-web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-1" connectable="0" parent="rel-1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#666666;" value="Accede vía web" vertex="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel-2" edge="1" parent="1" source="actor-cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#707070;strokeWidth=1;" target="app-mobile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-2" connectable="0" parent="rel-2" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#666666;" value="Accede vía móvil" vertex="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel-3" edge="1" parent="1" source="app-web" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#707070;strokeWidth=1;" target="backend-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel-4" edge="1" parent="1" source="app-mobile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#707070;strokeWidth=1;" target="backend-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel-5" edge="1" parent="1" source="backend-api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#707070;strokeWidth=1;" target="db-postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-5" connectable="0" parent="rel-5" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#666666;" value="Lee y escribe" vertex="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel-6" edge="1" parent="1" source="backend-api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#707070;strokeWidth=1;" target="ext-notificaciones">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rel-7" edge="1" parent="1" source="backend-api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#707070;strokeWidth=1;" target="ext-pagos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
