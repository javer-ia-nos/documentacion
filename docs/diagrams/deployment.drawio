        <mxCell id="compose-nota" value="Cada microservicio tiene su propia base PostgreSQL, inicializada con el init/sql/seed.sql de su repositorio. La imagen se compila con NODE_ENV=production, por lo que el Compose pasa JWT_SECRET, INTERNAL_SERVICE_TOKEN y CORS_ORIGINS con valores de prueba. Los eventos salen por el outbox de cada servicio hacia Kafka." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="1480" height="50" as="geometry" /></mxCell>
        <mxCell id="compose-cu12" value="Variante aislada para CU-12 (docker-compose.cu12-tests.yml): solo api-gateway, ms-seguridad, ms-core y ms-financiero con bases efímeras en tmpfs." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="885" width="1480" height="30" as="geometry" /></mxCell>
        <mxCell id="e-nav-web" value="HTTP :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="navegador" target="web"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-web-gw" value="/api → HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="web" target="gateway"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-gw-ms" value="HTTP (proxy) · gRPC (ms-core)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gateway" target="grupo-ms"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-ms-kafka" value="eventos (outbox → relay)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;labelBackgroundColor=#ffffff;dashed=1;exitX=0.95;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="grupo-ms" target="kafka"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-core-mock" value="HTTP (ACH / SWIFT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ms-core" target="mock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-host-compose" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=9;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="host" target="compose"><mxGeometry relative="1" as="geometry" /></mxCell>
