        <mxCell id="ms-auditoria" value="&lt;b&gt;ms-auditoria&lt;/b&gt;&lt;br&gt;:4867" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1328" y="535" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="db-auditoria" value="&lt;b&gt;serv-auditoria-db&lt;/b&gt;&lt;br&gt;[PostgreSQL]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1343" y="680" width="160" height="90" as="geometry" /></mxCell>
