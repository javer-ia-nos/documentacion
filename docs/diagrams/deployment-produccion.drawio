        <mxCell id="grupo-bd" value="7 instancias PostgreSQL 18 [Deployment de 1 réplica] — una por microservicio; ejemplo:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#444444;fontSize=10;" vertex="1" parent="1"><mxGeometry x="290" y="848" width="740" height="190" as="geometry" /></mxCell>
        <mxCell id="bd-p" value="&lt;b&gt;&amp;lt;svc&amp;gt;-db&lt;/b&gt;&lt;br&gt;PostgreSQL 18.6&lt;br&gt;volumen local-path" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="893" width="150" height="80" as="geometry" /></mxCell>
        <mxCell id="bd-svc" value="&lt;b&gt;Service &amp;lt;svc&amp;gt;-db&lt;/b&gt;&lt;br&gt;el microservicio se conecta aquí (pg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#1a1a1a;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="903" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="bd-nota" value="Sin replicación: el volumen local queda amarrado a la máquina donde se creó; si esa máquina se apaga, el microservicio queda sin base de datos hasta que vuelva." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="320" y="983" width="690" height="40" as="geometry" /></mxCell>
        <mxCell id="grupo-cron" value="CronJobs: pg_dump diario por base (08:00 UTC)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#1a1a1a;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="848" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="resp-nota" value="Volcados en un volumen del clúster, retención 7 días; sin WAL ni copias externas" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="908" width="190" height="40" as="geometry" /></mxCell>
