# Include this in the .gitignore file at the root of your Go project

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries (built with e.g., `go test -c`)
*.test

# Output of the go coverage tool, code coverage profiles
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file (local development overrides)
go.work
go.work.sum

# Dependency directories
# Un-comment the next line if you opt to vendor your dependencies
# vendor/

# Local environment variables
.env
.env.local

# Common IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

gen


