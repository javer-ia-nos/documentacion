        <!-- Phase 1 label -->
        <mxCell id="phase1-label" value="Fase 1 — Solicitud y creación del CDT o inversión" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="195" width="440" height="24" as="geometry" />
        </mxCell>

        <!-- Steps 1-12 (solicitud y creación) -->
        <mxCell id="step1" value="1. Solicita abrir un CDT o inversión&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#888888&quot;&gt;(monto, plazo, producto)&lt;/font&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="230" as="sourcePoint" />
            <mxPoint x="450" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step2" value="2. Crea la solicitud (API)" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="300" as="sourcePoint" />
            <mxPoint x="750" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step3" value="3. Valida sesión y permisos" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="370" as="sourcePoint" />
            <mxPoint x="1050" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step4" value="4. Consulta tasa vigente (InterestRate) y saldo de la cuenta origen" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="440" as="sourcePoint" />
            <mxPoint x="1350" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step5" value="5. Retorna tasa aplicable y saldo" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;dashed=1;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1350" y="510" as="sourcePoint" />
            <mxPoint x="750" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note-saldo" value="Si el saldo es insuficiente para el monto solicitado: se rechaza la solicitud y no se crea el CDT ni la inversión." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacing=6;size=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="525" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step6" value="6. Crea el CDT o Investment y descuenta el saldo de la cuenta origen" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="630" as="sourcePoint" />
            <mxPoint x="1350" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step7" value="7. Registra el evento de apertura" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="700" as="sourcePoint" />
            <mxPoint x="1650" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step8" value="8. Notifica la apertura exitosa" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="770" as="sourcePoint" />
            <mxPoint x="1950" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step9" value="9. Envía alerta (push / email / SMS)" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1950" y="840" as="sourcePoint" />
            <mxPoint x="2250" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step10" value="10. Entrega la confirmación al cliente (canal externo)" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;dashed=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2250" y="910" as="sourcePoint" />
            <mxPoint x="150" y="910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step11" value="11. Responde con el CDT/inversión creado" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;dashed=1;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="980" as="sourcePoint" />
            <mxPoint x="450" y="980" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step12" value="12. Muestra confirmación y fecha de vencimiento" style="html=1;endArrow=blockThin;endFill=1;endSize=10;startArrow=none;dashed=1;strokeColor=#404040;strokeWidth=1.5;fontSize=11;fontColor=#262626;align=center;verticalAlign=bottom;labelBackgroundColor=#F5F5F5;spacingBottom=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="1050" as="sourcePoint" />
            <mxPoint x="150" y="1050" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Phase divider -->
        <mxCell id="divider" style="html=1;endArrow=none;startArrow=none;dashed=1;strokeColor=#B0B0B0;strokeWidth=1;" edge="1" parent="1">
