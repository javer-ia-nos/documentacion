<mxCell id="comp-3" value="&lt;b&gt;Autenticación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Inicio y cierre de sesión, autenticación biométrica (huella/rostro), recuperación y restablecimiento de contraseña, verificación de identidad, control de sesiones.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;arcSize=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="comp-4" value="&lt;b&gt;Seguridad&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cambio de contraseña, autenticación 2FA, alertas de seguridad push, dispositivos confiables, bloqueo y desbloqueo de usuario.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;arcSize=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="260" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="comp-5" value="&lt;b&gt;Inicio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Saldo total, resumen de cuentas y tarjetas, últimos movimientos, notificaciones importantes, accesos rápidos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;arcSize=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="260" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="comp-6" value="&lt;b&gt;Tarjetas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Mis tarjetas, débito y crédito, estado de tarjeta, cupos, información de tarjeta, activarla y bloquearla.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;arcSize=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1040" y="260" width="240" height="120" as="geometry"/></mxCell>
